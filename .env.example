# === Host-exposed ports (used by run.sh, stop.sh, docker-compose port mappings) ===
# Loopback by default: the indexing endpoints read arbitrary local paths and
# are unauthenticated unless AUTH_ENABLED=true, so they must not be on the
# network out of the box. Set 0.0.0.0 ONLY if something off-host must reach the
# indexer — notably the opt-in http-mcp container, which reaches it via
# host.docker.internal and cannot see a loopback-only bind.
INDEXER_HOST=127.0.0.1
INDEXER_PORT=8001
MCP_SERVER_PORT=8000

# === MCP transport ===
# Read ONLY by the `treeloom-mcp` console script (mcp_stdio.main()) — NOT by
# the mcp-server container, whose Dockerfile CMD always runs the SSE app
# regardless of this var. The container's transport is switched entirely by
# the compose profile (COMPOSE_PROFILES=http-mcp), never by this variable.
# Leave this at the default 'stdio' unless you are running `treeloom-mcp`
# itself and, unusually, want it to speak HTTP+SSE locally instead — setting
# 'sse' here does NOT start or affect the mcp-server container, and does NOT
# require COMPOSE_PROFILES=http-mcp or vice versa.
# stdio (default) runs one MCP server process per user, spawned by the client,
# with no network surface at all — point your MCP client at the `treeloom-mcp`
# command. 'sse' is deprecated upstream since MCP protocol revision 2025-03-26.
TREELOOM_MCP_TRANSPORT=stdio

# The MCP caller's OWN credential, used when no per-request bearer is available
# (i.e. always, on stdio). A treeloom PAT or API key. The indexer enforces this
# principal's permissions, so MCP access is exactly as privileged as calling
# the indexer directly.
TREELOOM_MCP_TOKEN=

# Read by the `mcp-server` container (application/main.py) only — irrelevant
# unless you've opted into COMPOSE_PROFILES=http-mcp. The MCP HTTP transport
# (/sse + /messages/) has NO authentication of its own: every tool call flows
# through it. It is therefore published on 127.0.0.1 only (docker-compose.yml),
# per the MCP spec's "bind localhost when running locally".
#
# Origin validation (MCP spec: MUST for HTTP transports) guards against a
# browser on a malicious site driving the transport cross-origin. Comma-
# separated exact origins; empty = loopback-only (localhost / 127.0.0.1 / [::1]
# on any port). Setting this REPLACES the loopback default, so include any
# loopback origin you still need.
TREELOOM_MCP_ALLOWED_ORIGINS=

# Read by the MCP server on ANY transport — `_service_account_enabled()` is
# consulted from `_tool_auth_headers`, which every write/admin tool calls
# regardless of stdio vs. the opt-in HTTP+SSE container. MCP tools send the
# CALLER's own bearer (or, on stdio, TREELOOM_MCP_TOKEN) to the indexer first;
# this only matters when neither is present. Set to 'true' to let the
# TREELOOM_MCP_API_KEY service account stand in for that uncredentialed
# caller. Intended for stdio / single-user setups where the MCP client cannot
# attach a bearer; opting in on a SHARED transport (the HTTP+SSE container
# with multiple callers) means any caller who sends no credential of their
# own acts as the service account. Never used by the nine per-repo-scoped
# read tools (search_code, find_*, etc.) on any transport — see
# docs/authz.md. Off unless exactly 'true'.
TREELOOM_MCP_SERVICE_ACCOUNT=
TEI_EMBEDDING_PORT=8082
TEI_RERANKER_PORT=8081
NEO4J_BOLT_PORT=7687
NEO4J_HTTP_PORT=7474

# === URLs the host-based indexer/server uses to reach services ===
EMBEDDING_URL=http://localhost:8082
RERANKER_URL=http://localhost:8081
NEO4J_URI=bolt://localhost:7687
INDEXER_URL=http://localhost:8001

# === URL the mcp-server container uses to reach the host indexer ===
#     (host.docker.internal maps to the host machine)
DOCKER_INDEXER_URL=http://host.docker.internal:8001

# === Milvus ===
# Quickstart default: the in-compose Milvus standalone (COMPOSE_PROFILES
# includes local-infra below). It speaks plain HTTP, so MILVUS_URI must be set
# explicitly — the code's default scheme is https. For an external/managed
# Milvus, drop local-infra from COMPOSE_PROFILES and point all three at it.
MILVUS_HOST=localhost
MILVUS_PORT=19530
MILVUS_URI=http://localhost:19530

# === Compose profiles (comma-separated; consumed by run.sh) ===
#   local-infra  Neo4j + Milvus standalone in compose (the quickstart default)
#   qwen3        Qwen3 reranker service (quality option; see below)
#   cpu          CPU embedding server instead of the GPU one (no NVIDIA GPU;
#                also set EMBEDDING_URL=http://localhost:8083)
COMPOSE_PROFILES=local-infra

# === Models ===
EMBEDDING_MODEL=jinaai/jina-embeddings-v2-base-code
RERANKER_MODEL=BAAI/bge-reranker-v2-m3
HF_TOKEN=

# Extra TEI CLI flags appended to the tei-embedding / tei-reranker commands.
# Use for per-model flags like --pooling cls, --max-batch-tokens 16384, etc.
# Must be defined in .env (may be empty); split on whitespace by docker compose.
EMBEDDING_EXTRA_ARGS=
RERANKER_EXTRA_ARGS=

# Optional standalone reranker service (services/jina_reranker) for models TEI
# can't host, e.g. jinaai/jina-reranker-v2-base-multilingual. Opt-in:
#   docker compose --profile jina up -d --build jina-reranker
# then set RERANKER_URL=http://localhost:8085 and restart the indexer.
JINA_RERANKER_PORT=8085
JINA_RERANKER_MODEL=jinaai/jina-reranker-v2-base-multilingual
JINA_RERANKER_GPU=0

# === Reranker choice: bge (TEI, default) vs Qwen3 (services/qwen3_reranker) ===
# Measured on featbit-clean-100 (deterministic, pool 50, RTX 3060):
#   bge-reranker-v2-m3   r@1 0.66  r@5 0.84  MRR 0.730   ~0.9 s/query  ~1.2 GB VRAM
#   Qwen3-Reranker-0.6B  r@1 0.70  r@5 0.90  MRR 0.786   ~3 s/query    ~1.5 GB VRAM
# Qwen3 is the quality choice; bge is the latency choice and remains the
# standard default here. To switch to Qwen3 (TEI can't host it — this is a
# transformers-based drop-in, see services/qwen3_reranker/README.md):
#   COMPOSE_PROFILES=qwen3        (run.sh then starts the service)
#   RERANKER_URL=http://localhost:8086
# and restart the host indexer. Switch back by reverting RERANKER_URL.
QWEN3_RERANKER_PORT=8086
QWEN3_RERANKER_MODEL=tomaarsen/Qwen3-Reranker-0.6B-seq-cls
QWEN3_RERANKER_GPU=0

# === Neo4j auth ===
NEO4J_USER=neo4j
NEO4J_PASSWORD=treeloom_pass

# === Chunking ===
CHUNK_SIZE=512

# === Retrieval: pre-rerank pool ===
# Number of candidates pulled from Milvus before reranking. Higher = better
# recall, more rerank cost. TEI rerank is batched so any size works.
MILVUS_TOP_K_PRE_RERANK=50
# Per-batch input size to TEI's /rerank (server caps at ~20).
RERANK_BATCH_SIZE=20

# === Retrieval: hybrid (dense + BM25) ===
# 1 = use Milvus hybrid_search with dense + sparse (BM25) via RRF fusion.
# 0 = dense-only (legacy). Toggling off is useful for A/B comparison.
USE_HYBRID=1
# RRF fusion constant. Lower k = more weight to top-of-list across channels.
RRF_K=60

# === LLM (OpenAI-compatible /v1/chat/completions) ===
# Used for HyDE query expansion and per-chunk summary generation.
# Required even if USE_HYDE=0 and USE_SUMMARY_VECTOR=0 (fail-loud config).
# Quickstart default: Ollama on the host (ollama pull qwen2.5-coder:7b).
# Any OpenAI-compatible endpoint works (llama.cpp server, vLLM, OpenAI, ...).
# If the LLM is unreachable at runtime, indexing and search still work —
# treeloom silently falls back to no-HyDE / no-summary.
LLM_URL=http://localhost:11434/v1
LLM_MODEL=qwen2.5-coder:7b
LLM_TIMEOUT=30
LLM_HYDE_TIMEOUT=5
LLM_CONCURRENCY=4
LLM_HYDE_MAX_TOKENS=256
LLM_SUMMARY_MAX_TOKENS=60
# 1 = leave reasoning/thinking on (Qwen3, DeepSeek-R1, etc.). Default 0 because
# HyDE wants 5-25 lines of code and summaries want one sentence — thinking is
# pure latency overhead for both, and at 10k+ chunks adds hours per re-index.
LLM_ENABLE_THINKING=0

# === Retrieval: HyDE ===
# 1 = generate hypothetical code snippet for query, embed it, fuse with literal.
# Falls back silently to no-HyDE if LLM is unreachable at query time.
USE_HYDE=1

# === Retrieval: per-chunk summary embeddings ===
# 1 = at index time, generate one-line LLM summary per chunk, embed it,
# store as second dense vector. Search adds it to hybrid_search reqs.
# Falls back silently to no-summary if LLM is unreachable at index time.
USE_SUMMARY_VECTOR=1
# Where the SQLite summary cache lives (keyed by chunk SHA1 + LLM_MODEL).
TREELOOM_CACHE_DIR=~/.treeloom

# === Retrieval: graph RESCORING in scoring ===
# 1 = post-rerank, combine TEI relevance with community-summary cosine,
# entity centrality, and entity-name-in-query. DEFAULT 1: ablations showed
# rescoring adds ~0 over a STRONG reranker (Cohere), but re-validation
# under the production reranker (Qwen3-0.6B) found it still lifts rank-1
# materially (guava symbol-free recall@1 0.16→0.49). The neighbor/community
# PAYLOAD is always returned independent of this flag. Set to 0 (payload-only)
# with a Cohere-class reranker, where rescoring is redundant + cheaper.
USE_GRAPH_SCORING=1
# Fusion weights — active when USE_GRAPH_SCORING=1 (default) or
# use_graph_scoring=true per /search request. Env-tunable via ab_features.py.
GRAPH_ALPHA=1.0   # rerank relevance score
GRAPH_BETA=0.3    # community summary match
GRAPH_GAMMA=0.2   # entity centrality
GRAPH_DELTA=0.4   # entity name in query
# Min-max normalize the raw rerank logits to [0,1] before fusion so the
# unbounded logit scale doesn't swamp the [0,1] graph signals. Set 0 to
# restore the raw-logit behavior.
RERANK_NORMALIZE=1
# File-level definition boost: extra weight for a file that DEFINES a
# Function/Class/... whose name is in the query (on top of the GRAPH_DELTA
# name term; excludes whole-file Module/filename matches). 0.0 = off.
# Promotes the whole defining file — the right granularity for file-level
# recall@1 (the per-chunk def/ref split was tried and reverted, it hurt).
GRAPH_EPSILON=0.0
# Log per-signal contribution + reorder deltas in graph_rescore (one query at
# a time). Off by default; turn on to diagnose why a signal isn't moving rank.
GRAPH_RESCORE_DEBUG=0

# === PostgreSQL (metadata store: users, source records) ===
# Connection string for asyncpg. PostgreSQL is optional — when absent or
# unreachable, treeloom falls back to in-memory mode with a warning.
DATABASE_URL=postgresql://treeloom:treeloom_pass@localhost:5432/treeloom

# === Authorization ===
# Set to true to require API key auth on mutating endpoints AND to enforce
# per-repo authorization on read endpoints (/search, /graph-explore, /find-*):
# a source_id-pinned query is 403'd unless the caller is authorized for it; a
# cross-repo query is 403'd unless the caller has all_access. When false, the
# system is fully open (single-tier). See docs/authz.md.
AUTH_ENABLED=false

# Local-dev admin while auth is off: with AUTH_ENABLED=false, a request from
# loopback (127.0.0.1 / ::1) that carries no X-Forwarded-* headers is treated as
# an admin, so the operator UI's admin tabs (Users & Groups, Access Tokens,
# Embedding Backends) work without logging in. No effect when
# AUTH_ENABLED=true. Set to 0 on any shared host that runs with auth off.
TREELOOM_DEV_MODE=1

# REQUIRED when AUTH_ENABLED=true (startup fails without it). Keys the HMAC
# that makes a stored credential hash verifiable. If it is unset, a random
# secret is generated per process: every API key, PAT and session cookie
# stops verifying on restart, and with more than one indexer worker, auth
# succeeds or fails depending on which worker answers. Set it once and keep
# it — changing it invalidates every issued credential.
# Generate one: python -c "import secrets; print(secrets.token_hex(32))"
TREELOOM_HMAC_SECRET=

# With AUTH_ENABLED=true, keep SEARCH anonymous while still protecting indexing
# (the simple single-tier evaluator path). Leave empty to enforce search authz.
TREELOOM_SEARCH_OPEN=

# Admin API key for the seed admin user created on first startup.
# Generate one: python -c "import secrets; print(secrets.token_urlsafe(32))"
TREELOOM_ADMIN_KEY=

# === Local auth bootstrap & session settings ===
# If the users table is empty at startup and both vars are set, a first admin
# user is created with a bcrypt password_hash (best-effort, logged, idempotent).
# Leave empty if you manage users via the API.
TREELOOM_BOOTSTRAP_ADMIN_USER=
TREELOOM_BOOTSTRAP_ADMIN_PASSWORD=

# Browser session lifetime in hours (default 12). Sessions are stored in the
# `sessions` table; expired rows are pruned on each login.
TREELOOM_SESSION_TTL_HOURS=12

# Whether the treeloom_session cookie carries the Secure attribute.
#   auto (default) — Secure when the login arrived over HTTPS. Right for local
#                    HTTP dev and for a TLS deployment without either having to
#                    set anything. Behind a reverse proxy, set
#                    TREELOOM_LOGIN_TRUST_FORWARDED_FOR=1 so X-Forwarded-Proto
#                    is consulted (untrusted, a client could strip the flag
#                    from its own cookie by claiming plain http).
#   1 / 0          — state it explicitly if you know your topology.
# This defaulted to 0, so any deployment that did not think about it served a
# session cookie browsers would send over plain HTTP.
TREELOOM_COOKIE_SECURE=auto

# CORS allowed origins for the operator UI v2 SPA, comma-separated EXACT origins
# (scheme+host+port), e.g. https://ui.example.com,http://localhost:3001
# REQUIRED for the SPA's username/password login: that uses a session cookie, a
# credentialed cross-origin request, and the wildcard default (allow_origins=*,
# NO credentials) cannot serve credentialed requests. With explicit origins set,
# the indexer sends allow-credentials + the exact origin. run.sh defaults this to
# http://localhost:${UI_PORT} when unset. The SameSite=Lax session cookie works
# same-site (localhost, or ui.x.com<->api.x.com); a truly cross-DOMAIN prod split
# would additionally need SameSite=None;Secure (not configured here yet).
TREELOOM_CORS_ORIGINS=http://localhost:3001

# ── Operator UI v2 container ──────────────────────────
# Host port for the `ui` compose service (grafana owns 3000, so default 3001).
UI_PORT=3001
# API base the SPA's browser calls. Must be reachable FROM THE BROWSER — the
# indexer runs on the host, so this is a host URL, not a compose service name.
TREELOOM_API_BASE=http://localhost:8001

# Login brute-force rate limit. After LOGIN_MAX_ATTEMPTS failed
# logins for the same (username, client_ip) within LOGIN_WINDOW_SECONDS, the
# next attempt is refused with 429 + Retry-After (before bcrypt runs). A
# successful login clears the counter for that pair. The counter lives in
# Postgres (login_attempts table) so it works across indexer workers.
TREELOOM_LOGIN_MAX_ATTEMPTS=5
TREELOOM_LOGIN_WINDOW_SECONDS=300
# Second limit, on the username alone across ALL client IPs, for the same
# window. The per-(username, IP) limit above does nothing against a spray from
# many source addresses, which is the shape an actual credential-stuffing run
# takes. Set higher than LOGIN_MAX_ATTEMPTS: it has to sit above the traffic a
# handful of legitimate people fumbling the same shared account would produce.
TREELOOM_LOGIN_MAX_ATTEMPTS_PER_USERNAME=50
# Set to 1 ONLY when behind a trusted reverse proxy so the limiter keys on the
# real client IP from X-Forwarded-For; otherwise clients could spoof it.
TREELOOM_LOGIN_TRUST_FORWARDED_FOR=0
# How long an attempt waits for the per-username lock that serializes the
# counting, before giving up and returning 429. The bound matters: the lock is
# held across a pooled connection's transaction, so an unbounded wait lets a
# flood against one username park one connection per in-flight request and
# starve every other endpoint of database connections.
TREELOOM_LOGIN_LOCK_WAIT_MS=250
# Periodic purge of login_attempts rows past the retention window. Nothing
# reads a row once it leaves the sliding window, and clear() only fires on a
# *successful* login — which a brute-force run never produces — so without
# this the table only grows. Retention defaults to 4x the window (min 1h),
# comfortably past anything the throttle still counts.
TREELOOM_LOGIN_PURGE_ENABLED=true
TREELOOM_LOGIN_PURGE_INTERVAL_SECONDS=3600
TREELOOM_LOGIN_PURGE_RETENTION_SECONDS=

# === Incremental webhook indexing ===
# Bounded retry: how many times to attempt an incremental job before
# moving it to DEAD_LETTER. Default: 3. Applies only to incremental
# (webhook-triggered) jobs — repo/graph/file/directory jobs are not
# auto-retried.
# MAX_JOB_ATTEMPTS=3

# Backpressure: reject new webhook submissions with 429 when the Postgres
# job_queue has this many rows or more (prevents unbounded backlog growth
# under sustained merge velocity).
# MAX_QUEUE_DEPTH=500

# Oversized push fallback: if a webhook delivers more than this many changed
# files, fall back to a full re-index job for the source instead of a giant
# incremental payload. One bounded job replaces a payload that could exhaust
# memory or exceed DB limits.
# MAX_CHANGED_FILES=5000

# --- Webhook indexing (merged pull requests; GitHub and Gitea) ---
# POST /webhook is disabled (503) until the matching secret is set. The
# secret verifies the HMAC signature on every delivery; the token is used
# only for the outbound "list files in this PR" API call, and the Gitea base
# URL is required for that call on Gitea. See docs/incremental-indexing.md.
# WEBHOOK_GITHUB_SECRET=
# WEBHOOK_GITHUB_TOKEN=
# WEBHOOK_GITEA_SECRET=
# WEBHOOK_GITEA_BASE_URL=https://gitea.example.com
# WEBHOOK_GITEA_TOKEN=

# Freshness sampler: background task that exports per-source staleness + age
# Prometheus gauges. Disable on very large installations where git ls-remote
# calls add up (use FRESHNESS_MAX_SOURCES to cap cardinality instead).
# FRESHNESS_SAMPLER_ENABLED=true
# FRESHNESS_SAMPLE_INTERVAL_SECONDS=60
# FRESHNESS_MAX_SOURCES=200

# === Git remote policy (SSRF containment) ===
# /index-repo clones a caller-supplied URL and embeds every file into the
# vector + graph stores, where it is readable via /search. GIT_ALLOW_PROTOCOL
# constrains the SCHEME (http/https/ssh/git) but not the DESTINATION, so the
# host policy below is what stops an internal git daemon or a cloud-metadata
# address being cloned and exfiltrated.
#
# Always refused, regardless of these settings: link-local (169.254.0.0/16 —
# cloud metadata), unspecified, multicast and reserved addresses. No
# legitimate git remote lives there.
#
# Comma-separated exact hosts. When set, ONLY these are clonable. Leave empty
# to allow any host that passes the checks above.
TREELOOM_GIT_ALLOWED_HOSTS=
#
# Also refuse RFC1918 / unique-local destinations. OFF by default because
# self-hosted git on a private network is a first-class use case; turn it on
# if you only ever clone from the public internet. When on, hostnames are
# resolved to check their addresses — note this cannot prevent DNS rebinding
# between that lookup and git's own.
TREELOOM_GIT_BLOCK_PRIVATE=
#
# Permit git remotes on the loopback interface. OFF by default — a request to
# clone 127.0.0.1 is the shape of an SSRF probe, not of a deployment. Turn it
# on only for a git daemon you started yourself, which is what
# scripts/loadtest_merge_searchable.py needs (it serves fixture repos over
# git://localhost/). Not needed for indexing local repos by path.
TREELOOM_GIT_ALLOW_LOOPBACK=
#
# Let git follow HTTP redirects while cloning. OFF by default, because a
# redirect goes around the host policy above: the checks judge the URL you
# submitted, but git connects to wherever it redirects, so a public-looking
# URL answering 302 -> http://169.254.169.254/ reaches the address those
# checks exist to refuse. git's own default ('initial') still follows the
# first redirect and does not close this. The cost of leaving it off is that
# a moved or renamed upstream stops resolving until its URL is updated.
TREELOOM_GIT_FOLLOW_REDIRECTS=

# === TEI CPU fallback (dual-server mode) ===
TEI_EMBEDDING_CPU_PORT=8083
EMBEDDING_FALLBACK_URL=http://localhost:8083
GPU_MAX_TOKENS=4096

# === Vector dimension (must match embedding model) ===
VECTOR_DIM=768

# === OpenTelemetry tracing ===
# Endpoint of the OTel collector (gRPC). Leave at the default for the
# in-compose collector; point elsewhere when running the indexer outside
# the local stack.
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
# Head-based sampler. Local dev defaults to always_on so every trace
# reaches the local Tempo (the local collector has no tail sampling).
# In prod (shipping to a central collector) switch to
# parentbased_traceidratio at 0.1 — central tail_sampling then keeps every
# error and every trace whose root span > 30s.
OTEL_TRACES_SAMPLER=always_on
OTEL_TRACES_SAMPLER_ARG=1.0
# Override the resource service.name (default: treeloom-indexer).
# OTEL_SERVICE_NAME=treeloom-indexer
# Per-chunk LLM summary spans. Default off — hundreds of spans per file
# balloon trace size and Tempo storage; flip on when chasing a per-chunk
# LLM bottleneck.
OTEL_TRACE_PER_CHUNK=false
# Disable the SDK entirely (no spans emitted). Same effect as not
# installing the SDK, but lets you keep the dependency for dev environments.
# OTEL_SDK_DISABLED=true

# === Grafana ===
GRAFANA_PORT=3000
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin
# Set to true to view dashboards without logging in (read-only).
GRAFANA_ANON_ENABLED=false

# Host directory of repos mounted read-only into the benchmark container at /data/repos
#BENCHMARK_REPOS_DIR=./benchmark-repos

# === Benchmark LLM (agentic grep-vs-treeloom; resolve_llm_config) ===
# The benchmark harness uses its OWN LLM config (NOT LLM_URL/LLM_MODEL above).
# It drives a real agent loop + LLM-as-judge, so it needs a model that can
# follow the ReAct/tool protocol — a small local model is too weak.
#
# Resolution precedence: NOMCP_LLM_* (below) > the tier picked by
# BENCHMARK_QUALITY. Tier = STANDARD selects the DeepSeek block; anything else
# (incl. unset) selects BASIC.
BENCHMARK_QUALITY=BASIC

# BASIC tier — a local OpenAI-compatible server (defaults shown).
# BASIC_BENCHMARK_LLM_API_BASE=http://localhost:11434/v1
# BASIC_BENCHMARK_LLM_API_KEY=
# BASIC_BENCHMARK_LLM_MODEL=qwen2.5-coder:7b
# BASIC_BENCHMARK_LLM_TIMEOUT=45

# STANDARD tier — DeepSeek (or any OpenAI-compatible API). Set BENCHMARK_QUALITY=STANDARD
# to use it. The key falls back to DEEPSEEK_API_KEY if the _API_KEY var is unset.
# STANDARD_BENCHMARK_LLM_API_BASE=https://api.deepseek.com/v1
# STANDARD_BENCHMARK_LLM_API_KEY=
# DEEPSEEK_API_KEY=sk-...
# STANDARD_BENCHMARK_LLM_MODEL=deepseek-chat
# STANDARD_BENCHMARK_LLM_TIMEOUT=30

# Direct overrides — win over whichever tier is selected. Easiest way to point
# the benchmark at one specific endpoint/model regardless of tier.
# NOMCP_LLM_URL=http://host:port/v1
# NOMCP_LLM_API_KEY=
# NOMCP_LLM_MODEL=
# NOMCP_LLM_TIMEOUT=45
