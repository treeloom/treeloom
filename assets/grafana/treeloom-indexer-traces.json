  "description": "Per-stage span breakdown for the Treeloom indexer. Tempo-backed.",
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 0,
  "id": null,
  "links": [],
  "liveNow": false,
  "panels": [
    {
      "id": 1,
      "type": "traces",
      "title": "Recent indexer traces",
      "datasource": { "type": "tempo", "uid": "tempo" },
      "gridPos": { "h": 10, "w": 24, "x": 0, "y": 0 },
      "targets": [
        {
          "queryType": "traceql",
          "query": "{ resource.service.name = \"treeloom-indexer\" }",
          "limit": 50,
          "tableType": "traces",
          "refId": "A"
        }
      ]
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Per-file p50/p95/p99",
      "description": "Quantiles of index_file root-span duration. Each file is its own root trace; aggregate by job_id via TraceQL to break down per-job.",
      "datasource": { "type": "tempo", "uid": "tempo" },
      "gridPos": { "h": 6, "w": 8, "x": 0, "y": 10 },
      "targets": [
        {
          "queryType": "traceql",
          "query": "{ resource.service.name = \"treeloom-indexer\" && name = \"index_file\" } | quantile_over_time(duration, 0.5, 0.95, 0.99)",
          "refId": "A"
        }
      ]
    },
    {
      "id": 3,
      "type": "heatmap",
      "title": "Per-file duration vs file size",
      "description": "TraceQL: filter to index_file spans; x=file size, y=duration.",
      "datasource": { "type": "tempo", "uid": "tempo" },
      "gridPos": { "h": 10, "w": 16, "x": 8, "y": 10 },
      "targets": [
        {
          "queryType": "traceql",
          "query": "{ resource.service.name = \"treeloom-indexer\" && name = \"index_file\" } | select(span.treeloom.file_size_bytes, duration)",
          "refId": "A"
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Per-stage time per file (stacked)",
      "description": "Stacked: parse_and_chunk / embed.chunks / summaries.* / milvus.insert_chunks / graph.index_file",
      "datasource": { "type": "tempo", "uid": "tempo" },
      "gridPos": { "h": 10, "w": 24, "x": 0, "y": 20 },
      "fieldConfig": {
        "defaults": {
          "custom": { "drawStyle": "bars", "stacking": { "mode": "normal" } }
        }
      },
      "targets": [
        {
          "queryType": "traceql",
          "query": "{ resource.service.name = \"treeloom-indexer\" && (name = \"parse_and_chunk\" || name = \"embed.chunks\" || name = \"summaries.generate_batch\" || name = \"embed.summaries\" || name = \"milvus.insert_chunks\" || name = \"graph.index_file\") } | rate() by (name)",
          "refId": "A"
        }
      ]
    },
    {
      "id": 5,
      "type": "table",
      "title": "Slowest 20 files (last 24h)",
      "datasource": { "type": "tempo", "uid": "tempo" },
      "gridPos": { "h": 10, "w": 12, "x": 0, "y": 30 },
      "targets": [
        {
          "queryType": "traceql",
          "query": "{ resource.service.name = \"treeloom-indexer\" && name = \"index_file\" && duration > 100ms } | select(span.treeloom.file_path, span.treeloom.file_size_bytes, duration)",
          "limit": 20,
          "tableType": "spans",
          "refId": "A"
        }
      ]
    },
    {
      "id": 6,
      "type": "table",
      "title": "Errored files",
      "datasource": { "type": "tempo", "uid": "tempo" },
      "gridPos": { "h": 10, "w": 12, "x": 12, "y": 30 },
      "targets": [
        {
          "queryType": "traceql",
          "query": "{ resource.service.name = \"treeloom-indexer\" && name = \"index_file\" && status = error } | select(span.treeloom.file_path, span.treeloom.job_id, duration)",
          "limit": 100,
          "tableType": "spans",
          "refId": "A"
        }
      ]
    }
  ],
